# BSNL Bengaluru City Police trunk
# Pilot Number: 080-24425600
SLUG=bsnl
PROTO=softether

# SoftEther VPN concentrator
CONCENTRATOR=117.198.215.13:443
VHUB=BSNL_VH1
VPN_USERNAME="BLR_KTK_918024425600"   # must match the cert CN / vhub user entry
VPN_AUTH=cert                         # 'cert' (X.509) or 'standard' (password)

# Private IP assigned by BSNL on the tunnel side
CUSTOMER_IP=172.23.2.175
CUSTOMER_CIDR=16              # /16 so gateway 172.23.0.1 is on-link from 172.23.2.175
GATEWAY=172.23.0.1

# Only these subnets route through the tunnel — never a default route
ROUTES="10.191.5.1/32 10.191.5.8/29"

# SIP side (informational; used by trunk_template.sql substitution)
SIP_SERVER=10.191.5.1:5060
SIP_FROM_DOMAIN=ktk.stbi.ims.bsnl.in
SIP_USERNAME="+918024425600"
TRUNK_NAME=bsnl_bcp
CALLER_ID="+918024425600"
