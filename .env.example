# Copy to .env on each host and fill in real values.
# docker compose reads this automatically from the working directory.

# Identity for crash webhook / logs
SERVER_ID=x

# Network
PUBLIC_IP=0.0.0.0

# SIP credentials (secret — do NOT commit the real .env)
ASTERISK_IP=0.0.0.0
SIP_USERNAME=india_media_username
SIP_PASSWORD=changeme

# MariaDB (read by sip_outbound db_manager)
MARIA_DB_USERNAME=asterisk
MARIA_DB_PASS=changeme

# AWS S3 (recordings upload)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY=changeme
AWS_SECRET_KEY=changeme
AWS_BUCKET_NAME=changeme.vocallabs.ai

# Load Balancer
LOADBALANCER_ENDPOINT=https://changeme.vocallabs.ai
